{
  "name": "hostel-panchayat",
  "version": "1.0.0",
  "description": "Hostel Panchayat desktop app",
  "main": "electron-main.js",
  "author": "Raghav",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hostelpanchayat.desktop",
    "productName": "Hostel Panchayat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "gemini/**/*",
      "songs/**/*",
      "logo.png",
      "electron-main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Hostel-Panchayat-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
